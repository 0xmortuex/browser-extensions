{
  "manifest_version": 3,
  "name": "GitHub Pulse",
  "version": "1.0.0",
  "description": "A bar under every GitHub repo: latest workflow runs, deployment, release, and your Cloudflare Worker's last deploy.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.cloudflare.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["pulse-logic.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": { "16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png" }
}
